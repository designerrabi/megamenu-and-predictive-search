
{%- style -%}
:root {
  --pl-text: #111;
  --pl-green: #008a00;
  --pl-panel: #f4f4f1;
  --pl-border: #d7d7d2;
}

/* Header */
.pl-header {
  position: sticky;
  top: 0;
  z-index: 60;
  width: 100%;
  background: #fff;
  color: var(--pl-text);
  border-bottom: 1px solid #d9d9d9;
  isolation: isolate;
}

.pl-header-inner {
  min-height: 64px;
  max-width: 1360px;
  margin: 0 auto;
  padding: 0 36px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 160px minmax(0, 1fr);
  align-items: stretch;
}

.pl-nav-list {
  list-style: none;
  margin: 0;
  padding: 0;
  height: 100%;
  display: flex;
  align-items: center;
  gap: 24px;
}

.pl-nav-right .pl-nav-list {
  justify-content: flex-end;
}

.pl-nav-item {
  position: relative;
  height: 100%;
  display: flex;
  align-items: center;
}

.pl-nav-item:has(.pl-mega) {
  position: static;
}

.pl-nav-link {
  display: flex;
  align-items: center;
  gap: 4px;
  color: #111;
  text-decoration: none;
  font-size: 15px;
  font-weight: 700;
}

.pl-nav-link svg {
  width: 18px;
  height: 18px;
  transition: .25s;
}

.pl-nav-item:hover .pl-nav-link svg {
  transform: rotate(180deg);
}

.pl-logo {
  display: flex;
  align-items: center;
  justify-content: center;
}

.pl-logo a {
  display: flex;
  align-items: center;
  color: #111;
  text-decoration: none;
}

.pl-logo img {
  width: {{ section.settings.logo_width }}px;
  max-width: 100%;
  height: auto;
  display: block;
}

.pl-logo-text {
  font-size: 24px;
  font-weight: 900;
}

.pl-icons {
  display: flex;
  align-items: center;
  gap: 16px;
}

.pl-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
  text-decoration: none;
}

.pl-icon svg {
  width: 24px;
  height: 24px;
}

.pl-cart-count {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--pl-green);
  color: #fff;
  font-size: 10px;
  line-height: 16px;
  text-align: center;
}

/* Arrow */
.pl-arrow-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 0;
}

.pl-arrow-icon svg {
  width: 24px;
  height: 24px;
  display: block;
  transition: transform .25s ease;
}

.pl-acc-title.is-open > .pl-arrow-icon svg {
  transform: rotate(90deg);
}

/* Mega menu */
.pl-nav-item:hover > .pl-mega {
  display: block;
}

.pl-mega {
  display: none;
  position: absolute;
  left: 0;
  top: 100%;
  width: 100%;
  z-index: 9999;
}

.pl-mega-box {
  position: relative;
  z-index: 2;
  width: 100%;
  background: #fff;
  display: grid;
  grid-template-columns: 452px minmax(0, 1fr);
  border-radius: 0 0 18px 18px;
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0,0,0,.18);
  min-height: 520px;
}

.pl-mega-side {
  background: var(--pl-panel);
  padding: 52px 50px;
  transform: translateX(-16px);
  opacity: 0;
  transition: transform .32s ease, opacity .32s ease;
}

.pl-nav-item:hover > .pl-mega .pl-mega-side {
  transform: translateX(0);
  opacity: 1;
}

.pl-side-link {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #222;
  text-decoration: none;
  font-size: 20px;
  line-height: 1.2;
  font-weight: 700;
  padding: 27px 0;
  border-bottom: 1px solid #171717;
}

.pl-side-link.active,
.pl-side-link:hover {
  color: var(--pl-green);
}

.pl-side-btn {
  display: block;
  margin-top: 42px;
  background: var(--pl-green);
  color: #fff !important;
  text-align: center;
  text-decoration: none;
  border-radius: 999px;
  padding: 15px 24px;
  font-size: 18px;
  font-weight: 800;
}

.pl-products-wrap {
  min-width: 0;
  max-width: 1100px;
}

.pl-products {
  padding: 58px 56px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 32px;
  align-items: start;
}

.pl-mega-panel {
  display: none;
}

.pl-mega-panel.active {
  display: grid;
  animation: plMegaSlide .32s ease both;
}

@keyframes plMegaSlide {
  from {
    opacity: 0;
    transform: translateX(18px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.pl-product-card {
  color: #222;
  text-decoration: none;
  display: block;
}

.pl-product-img {
  background: #f4f0f8;
  border-radius: 18px;
  aspect-ratio: 1 / 1.25;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.pl-product-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .35s ease;
}

.pl-product-card:hover img {
  transform: scale(1.04);
}

.pl-product-card h3 {
  margin: 22px 0 8px;
  font-size: 18px;
  line-height: 1.18;
  font-weight: 800;
}

.pl-product-card p {
  margin: 0;
  font-size: 16px;
  color: #4f5158;
  line-height: 1.35;
}

/* Desktop search */
.pl-desktop-search-wrap {
  display: none;
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  min-height: 100px;
  background: #fff;
  z-index: 2147483000;
  align-items: center;
  padding: 12px 36px;
  gap: 16px;
  box-shadow: 0 8px 25px rgba(0,0,0,.08);
}

.pl-desktop-search-wrap.active {
  display: flex;
}

.pl-desktop-search-form {
  flex: 1;
  display: flex;
  align-items: center;
  height: 46px;
  border: 2px solid #111;
  border-radius: 999px;
  padding: 0 20px;
  gap: 12px;
  background: #fff;
}

.pl-desktop-search-input {
  flex: 1;
  border: 0;
  outline: 0;
  font-size: 16px;
  font-weight: 500;
  background: transparent;
  min-width: 0;
}

.pl-desktop-search-input:focus,
.pl-desktop-search-input:focus-visible {
  outline: none !important;
  box-shadow: none !important;
}

.pl-desktop-search-clear,
.pl-desktop-search-close {
  background: none;
  border: 0;
  cursor: pointer;
  color: #111;
}

.pl-desktop-search-close {
  font-size: 34px;
  line-height: 1;
}

.pl-desktop-predictive {
  position: fixed;
  top: 74px;
  left: 0;
  width: 100%;
  background: #fff;
  box-shadow: 0 20px 50px rgba(0,0,0,.15);
  border-radius: 0 0 18px 18px;
  z-index: 2147482999;
  display: none;
  max-height: 500px;
  overflow-y: auto;
}

.pl-desktop-predictive.active {
  display: block;
}

.pl-desktop-predict-inner {
  max-width: 1360px;
  margin: 0 auto;
  padding: 24px 36px 30px;
}

.pl-desktop-predict-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

/* Mobile header */
.pl-mobile {
  display: none;
}

.pl-mobile-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16px;
}

.pl-hamburger {
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
}

.pl-hamburger span {
  display: block;
  width: 28px;
  height: 3px;
  background: #111;
  margin: 5px 0;
}

