<script>
(function() {
  var arrowSvg = '<span class="pl-arrow-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.705 6L8.295 7.41L12.875 12L8.295 16.59L9.705 18L15.705 12L9.705 6Z" fill="currentColor"></path></svg></span>';

  function esc(s) {
    return (s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function money(cents) {
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      return Shopify.formatMoney(cents, {{ shop.money_format | json }});
    }

    return '$' + (Number(cents) / 100).toFixed(2);
  }

  function imgUrl(image, size) {
    if (!image) return '';

    var url = typeof image === 'string' ? image : (image.url || image.src || '');
    if (!url) return '';

    return url.replace(/(\.[^.?]+)(\?.*)?$/, '_' + size + '$1$2');
  }

  function productPrice(p) {
    var price = Number(p.price_min || p.price || 0);
    var compare = Number(p.compare_at_price_min || 0);

    if (compare > price && price > 0) {
      return '<s>' + money(compare) + '</s><strong>' + money(price) + '</strong>';
    }

    if (price > 0) {
      return '<strong>' + money(price) + '</strong>';
    }

    return '';
  }

  function renderItem(p, mobile) {
    var img = imgUrl(p.featured_image, '400x400');
    var imgTag = img ? '<img src="' + img + '" alt="' + esc(p.title) + '" loading="lazy">' : '';
    var href = p.url || ('/products/' + (p.handle || ''));

    if (mobile) {
      return '<a href="' + href + '" class="pl-search-result-item">'
        + imgTag
        + '<div><h4>' + esc(p.title) + '</h4><div class="pl-price">' + productPrice(p) + '</div></div>'
        + '</a>';
    }

    return '<a href="' + href + '" class="pl-desktop-predict-item">'
      + '<div class="pl-desktop-predict-img">' + imgTag + '</div>'
      + '<h4>' + esc(p.title) + '</h4>'
      + '<div class="pl-predict-price">' + productPrice(p) + '</div>'
      + '</a>';
  }

  function suggest(q, cb) {
    fetch('/search/suggest.json?q=' + encodeURIComponent(q)
      + '&resources[type]=product'
      + '&resources[limit]=10'
      + '&resources[options][unavailable_products]=show'
      + '&resources[options][fields]=title,body,product_type,variants.title,vendor')
      .then(function(r) {
        return r.json();
      })
      .then(function(data) {
        var products = (data && data.resources && data.resources.results && data.resources.results.products) || [];
        cb(null, products);
      })
      .catch(function(e) {
        cb(e, []);
      });
  }

  var deskOpen = false;
  var deskTimer = null;
  var mobTimer = null;

  window.plOpenDesktopSearch = function() {
    var inner = document.getElementById('plDesktopInner');
    var wrap = document.getElementById('plDesktopSearchWrap');

    if (!inner || !wrap) return;

    document.documentElement.classList.add('pl-search-is-open');
    inner.style.display = 'none';
    wrap.classList.add('active');
    deskOpen = true;

    var inp = document.getElementById('plDesktopSearchInput');
    if (inp) {
      setTimeout(function() {
        inp.focus();
      }, 60);
    }
  };

  window.plCloseDesktopSearch = function() {
    var inner = document.getElementById('plDesktopInner');
    var wrap = document.getElementById('plDesktopSearchWrap');
    var pred = document.getElementById('plDeskPred');
    var inp = document.getElementById('plDesktopSearchInput');
    var clr = document.getElementById('plDeskClear');

    if (!inner || !wrap) return;

    document.documentElement.classList.remove('pl-search-is-open');
    wrap.classList.remove('active');
    inner.style.display = '';

    if (pred) pred.classList.remove('active');
    if (inp) inp.value = '';
    if (clr) clr.classList.remove('visible');

    deskOpen = false;
  };

  window.plDeskClearFn = function() {
    var inp = document.getElementById('plDesktopSearchInput');
    var pred = document.getElementById('plDeskPred');
    var clr = document.getElementById('plDeskClear');

    if (inp) {
      inp.value = '';
      inp.focus();
    }

    if (pred) pred.classList.remove('active');
    if (clr) clr.classList.remove('visible');
  };

  window.plDeskInput = function(value) {
    var q = (value || '').trim();
    var clr = document.getElementById('plDeskClear');
    var pred = document.getElementById('plDeskPred');

    if (clr) clr.classList.toggle('visible', q.length > 0);

    clearTimeout(deskTimer);

    if (q.length < 1) {
      if (pred) pred.classList.remove('active');
      return;
    }

    deskTimer = setTimeout(function() {
      var grid = document.getElementById('plDeskGrid');
      var label = document.getElementById('plDeskLabel');
      var status = document.getElementById('plDeskStatus');
      var viewAll = document.getElementById('plDeskViewAll');

      if (pred) pred.classList.add('active');
      if (grid) grid.innerHTML = '';
      if (status) status.textContent = 'Searching...';
      if (label) label.textContent = '';
      if (viewAll) viewAll.style.display = 'none';

      suggest(q, function(err, products) {
        if (status) status.textContent = '';

        if (err) {
          if (status) status.textContent = 'Press Enter to search';
          return;
        }

        if (!products.length) {
          if (status) status.textContent = 'No results found for "' + q + '"';
          return;
        }

        if (label) label.textContent = 'Results for "' + q + '"';
        if (grid) grid.innerHTML = products.slice(0, 8).map(function(p) { return renderItem(p, false); }).join('');

        if (viewAll) {
          viewAll.href = '/search?q=' + encodeURIComponent(q) + '&type=product&options[prefix]=last';
          viewAll.style.display = 'inline-flex';
        }
      });
    }, 250);
  };

  window.plToggleDrawer = function(focusSearch) {
    var drawer = document.getElementById('plDrawer');
    var overlay = document.getElementById('plOverlay');

    if (!drawer || !overlay) return;

    drawer.classList.toggle('active');
    overlay.style.display = drawer.classList.contains('active') ? 'block' : 'none';
    document.body.style.overflow = drawer.classList.contains('active') ? 'hidden' : '';

    if (drawer.classList.contains('active') && focusSearch) {
      var inp = document.getElementById('plMobInput');
      if (inp) {
        setTimeout(function() {
          inp.focus();
        }, 80);
      }
    }
  };

  window.plMobileSearch = function(value) {
    var q = (value || '').trim();
    var results = document.getElementById('plMobResults');
    var menu = document.getElementById('plMobMenu');
    var secondaryMenu = document.getElementById('plMobSecondaryMenu');
    var inner = document.getElementById('plMobInner');
    var status = document.getElementById('plMobStatus');

    clearTimeout(mobTimer);

    if (!results || !menu) return;

    if (q.length < 1) {
      results.classList.remove('active');
      menu.style.display = 'block';
      if (secondaryMenu) secondaryMenu.style.display = 'block';
      if (inner) inner.innerHTML = '';
      if (status) status.textContent = '';
      return;
    }

    results.classList.add('active');
    menu.style.display = 'none';
    if (secondaryMenu) secondaryMenu.style.display = 'none';
    if (status) status.textContent = 'Searching...';
    if (inner) inner.innerHTML = '';

    mobTimer = setTimeout(function() {
      suggest(q, function(err, products) {
        if (err) {
          if (status) status.textContent = 'Press Enter to search';
          return;
        }

        if (!products.length) {
          if (status) status.textContent = 'No results found';
          if (inner) inner.innerHTML = '';
          return;
        }

        if (status) status.textContent = '';
        if (inner) {
          inner.innerHTML = products.slice(0, 10).map(function(p) {
            return renderItem(p, true);
          }).join('')
          + '<a class="pl-predict-view-all" style="display:inline-flex" href="/search?q=' + encodeURIComponent(q) + '&type=product&options[prefix]=last">View all results ' + arrowSvg + '</a>';
        }
      });
    }, 250);
  };

  window.plClearSearch = function() {
    var inp = document.getElementById('plMobInput');

    if (!inp) return;

    inp.value = '';
    window.plMobileSearch('');
    inp.focus();
  };

  window.plToggleSubmenu = function(btn) {
    var sub = btn.nextElementSibling;

    if (!sub) return;

    var isOpen = sub.style.display === 'block';
    sub.style.display = isOpen ? 'none' : 'block';
    btn.classList.toggle('is-open', !isOpen);
  };

  document.addEventListener('click', function(e) {
    var searchBtn = e.target.closest('[data-pl-open-search]');

    if (searchBtn) {
      e.preventDefault();
      window.plOpenDesktopSearch();
      return;
    }

    if (deskOpen) {
      var wrap = document.getElementById('plDesktopSearchWrap');
      var pred = document.getElementById('plDeskPred');

      if (wrap && !wrap.contains(e.target) && pred && !pred.contains(e.target)) {
        window.plCloseDesktopSearch();
      }
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && deskOpen) {
      window.plCloseDesktopSearch();
    }
  });

  document.querySelectorAll('.pl-mega').forEach(function(mega) {
    var tabs = mega.querySelectorAll('[data-pl-mega-tab]');
    var panels = mega.querySelectorAll('[data-pl-mega-panel]');

    tabs.forEach(function(tab) {
      tab.addEventListener('mouseenter', function() {
        var i = tab.getAttribute('data-pl-mega-tab');

        tabs.forEach(function(t) {
          t.classList.remove('active');
        });

        panels.forEach(function(p) {
          p.classList.remove('active');
        });

        tab.classList.add('active');

        var panel = mega.querySelector('[data-pl-mega-panel="' + i + '"]');
        if (panel) panel.classList.add('active');
      });
    });
  });
})();
</script>

