  .pl-header-inner {
    padding: 0 20px;
    grid-template-columns: minmax(0, 1fr) 130px minmax(0, 1fr);
  }

  .pl-nav-list {
    gap: 14px;
  }

  .pl-nav-link,
  .pl-contact-link {
    font-size: 13px;
  }

  .pl-mega-box {
    grid-template-columns: 360px minmax(0, 1fr);
    min-height: 560px;
  }

  .pl-mega-side {
    padding: 42px 38px;
  }

  .pl-side-link {
    font-size: 21px;
    padding: 22px 0;
  }

  .pl-products {
    padding: 32px 26px;
    gap: 20px;
  }

  .pl-product-card p {
    font-size: 14px;
  }
}

/* Mobile header activation */
@media (max-width: 989px) {
  .pl-desktop {
    display: none !important;
  }

  .pl-mobile {
    background: #fff;
    padding: 10px 24px 16px;
    min-height: 70px;
    display: grid !important;
    grid-template-columns: 1fr auto;
    align-items: center;
  }

  .pl-mobile .pl-logo {
    justify-content: flex-start;
  }

  .pl-drawer {
    width: 100%;
    max-width: none;
    right: -100%;
    box-shadow: none;
  }

  .pl-drawer.active {
    right: 0;
  }
}

/* Small phone */
@media (max-width: 480px) {
  .pl-mobile {
    padding: 10px 18px 14px;
  }

  .pl-mobile-menu-card {
    padding: 24px 20px;
  }

  .pl-mobile-products {
    gap: 22px 14px;
  }

  .pl-acc-title {
    font-size: 17px;
  }

  .pl-search-result-item {
    grid-template-columns: 72px 1fr;
  }

  .pl-search-result-item img {
    width: 72px;
    height: 72px;
  }
}
{%- endstyle -%}

{%- capture pl_arrow_svg -%}
  <span class="pl-arrow-icon" aria-hidden="true">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9.705 6L8.295 7.41L12.875 12L8.295 16.59L9.705 18L15.705 12L9.705 6Z" fill="currentColor"></path>
    </svg>
  </span>
{%- endcapture -%}

<header class="pl-header">
  <div class="pl-header-inner pl-desktop" id="plDesktopInner">
    <nav class="pl-nav-left">
      <ul class="pl-nav-list">
        {% for block in section.blocks %}
          {% if block.type == 'menu_left' and block.settings.menu != blank %}
            {% for link in block.settings.menu.links %}
              <li class="pl-nav-item">
                <a href="{{ link.url }}" class="pl-nav-link">
                  {{ link.title }}
                  {% if link.links != blank %}
                    {% render 'pl-chevron' %}
                  {% endif %}
                </a>

                {% render 'pl-mega-menu',
                  link: link,
                  shop_all_link: section.settings.shop_all_link,
                  shop_all_text: section.settings.shop_all_text
                %}
