/* =========================
   OFFCANVAS Z-INDEX FIX
   GemPages Safe Layer
========================= */

.pl-drawer-overlay {
  position: fixed !important;
  inset: 0 !important;
  background: rgba(0,0,0,.45) !important;
  z-index: 2147483645 !important;
}

.pl-drawer {
  position: fixed !important;
  top: 0 !important;
  right: -560px;
  width: 520px;
  max-width: 92vw;
  height: 100dvh;
  background: #fff;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-shadow: -24px 0 60px rgba(0,0,0,.18);
  transition: right .35s ease;
  z-index: 2147483646 !important;
  isolation: isolate;
}

.pl-drawer.active {
  right: 0 !important;
}

.pl-drawer-inner {
  position: relative;
  z-index: 2;
  background: #f5f5f3;
  min-height: 100%;
  padding-bottom: 90px;
}

/* Force drawer content above everything */
.pl-mobile-menu-title,
.pl-mobile-search,
.pl-mobile-menu-card,
.pl-mobile-products,
.pl-mobile-secondary-menu,
.pl-mobile-contact-area {
  position: relative;
  z-index: 3;
}

/* GemPages fix */
html:has(.pl-drawer.active) .gp-section,
html:has(.pl-drawer.active) .gp-row,
html:has(.pl-drawer.active) .gp-column,
html:has(.pl-drawer.active) .gp-block,
html:has(.pl-drawer.active) [class*="gp-"] {
  z-index: 1 !important;
}

/* Prevent transformed sections from overlapping */
html:has(.pl-drawer.active) .gp-section *,
html:has(.pl-drawer.active) .gp-row *,
html:has(.pl-drawer.active) .gp-column * {
  z-index: auto;
}

/* Mobile full width */
@media (max-width: 989px) {
  .pl-drawer {
    width: 100%;
    max-width: 100%;
    right: -100%;
    box-shadow: none;
  }

  .pl-drawer.active {
    right: 0 !important;
  }
}

