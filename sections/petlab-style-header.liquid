            {% endfor %}
          {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <div class="pl-logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            width="{{ section.settings.logo_width }}"
          >
        {% else %}
          <span class="pl-logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <nav class="pl-nav-right">
      <ul class="pl-nav-list">
      {% for block in section.blocks %}
  {% if block.type == 'menu_right' and block.settings.menu != blank %}
    {% for link in block.settings.menu.links %}
      <li class="pl-nav-item {% if link.links != blank %}has-dropdown{% endif %}">
        <a href="{{ link.url }}" class="pl-nav-link">
          {{ link.title }}
          {% if link.links != blank %}
            {% render 'pl-chevron' %}
          {% endif %}
        </a>

        {% if link.links != blank %}
          {% if link.title contains 'Account' or link.title contains 'Help' %}
            <div class="pl-simple-dropdown">
              {% for child_link in link.links %}
                <a href="{{ child_link.url }}" class="pl-simple-dropdown-link">
                  {{ child_link.title }}
                </a>
              {% endfor %}
            </div>
          {% else %}
            {% render 'pl-mega-menu',
              link: link,
              shop_all_link: section.settings.shop_all_link,
              shop_all_text: section.settings.shop_all_text
            %}
          {% endif %}
        {% endif %}
