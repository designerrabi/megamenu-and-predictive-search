{% if link.links != blank %}
  <div class="pl-mega">
    <div class="pl-mega-box">
      <aside class="pl-mega-side">
        {% for child_link in link.links %}
          <a
            href="{{ child_link.url }}"
            class="pl-side-link {% if forloop.first %}active{% endif %}"
            data-pl-mega-tab="{{ forloop.index0 }}"
          >
            <span>{{ child_link.title }}</span>

            <span class="pl-side-arrow" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.705 6L8.295 7.41L12.875 12L8.295 16.59L9.705 18L15.705 12L9.705 6Z" fill="currentColor"></path>
              </svg>
            </span>
          </a>
        {% endfor %}

        <a href="{{ shop_all_link | default: link.url }}" class="pl-side-btn">
          {{ shop_all_text | default: 'Shop All Products' }}
        </a>

      </aside>

      <div class="pl-products-wrap">
        {% for child_link in link.links %}
          <div
            class="pl-products pl-mega-panel {% if forloop.first %}active{% endif %}"
            data-pl-mega-panel="{{ forloop.index0 }}"
          >
            {% assign shown_products = 0 %}

            {% if child_link.type == 'collection_link' and child_link.object != blank %}
              {% for product in child_link.object.products limit: 4 %}
                {% render 'pl-mega-product-card', product: product %}
                {% assign shown_products = shown_products | plus: 1 %}
              {% endfor %}
            {% endif %}

            {% if shown_products == 0 %}
              {% for grand_link in child_link.links %}
                {% if grand_link.type == 'collection_link' and grand_link.object != blank %}
                  {% for product in grand_link.object.products limit: 4 %}
                    {% if shown_products < 4 %}
                      {% render 'pl-mega-product-card', product: product %}
                      {% assign shown_products = shown_products | plus: 1 %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endif %}

            {% if shown_products == 0 %}
              <p class="pl-mega-empty">No products found in this collection.</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}